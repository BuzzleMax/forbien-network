{
  "expo": {
    "name": "ForBien",
    "slug": "forbien",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050B14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buzzlemax.forbien",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "ForBien uses Bluetooth for offline mesh in Forest/Mission mode.",
        "NSLocationWhenInUseUsageDescription": "ForBien needs location for mesh coordination and emergency routing."
      }
    },
    "android": {
      "package": "com.buzzlemax.forbien",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050B14"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "networkSecurityConfig": "./android/app/src/main/res/xml/network_security_config.xml"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "ForBien needs access to your photos to set your profile picture.",
          "cameraPermission": "ForBien needs access to your camera to take a profile picture."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.24",
            "kspVersion": "2.0.24-1.0.25"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a006aa37-c87d-4526-b609-10172226882f"
      }
    }
  }
}
