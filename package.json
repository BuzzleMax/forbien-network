{
  "name": "forbien",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev:hq": "npm --prefix forbien-hq-web run dev",
    "build:hq": "npm --prefix forbien-hq-web run build",
    "dev:web": "npx -y serve forbien-web -l 3000",
    "dev:website": "npx -y serve forbien-web -l 3000",
    "web:landing": "npx -y serve forbien-web -l 3000",
    "test:hq": "node src/lib/test-hq-functionality.js",
    "test:ble": "node src/lib/test-ble-protocol.js",
    "test:crypto": "node src/lib/test-crypto-suite.js",
    "test:physical": "node src/lib/test-hq-physical.js",
    "test:auth": "node src/lib/test-hq-authentication.js",
    "test:mtu": "node src/lib/test-mtu-fragmentation.js",
    "test:all": "npm run test:auth && npm run test:hq && npm run test:ble && npm run test:crypto && npm run test:physical && npm run test:mtu"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-av": "^16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-network": "~8.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-ble-plx": "^3.2.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-preset-expo": "~54.0.10",
    "eas-cli": "^23.2.0"
  },
